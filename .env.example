# ─── Banco (PostgreSQL / Neon) ──────────────────────────────────────────────
# DATABASE_URL: com pooler (usada pelo app em runtime)
# DIRECT_URL:   sem pooler — obrigatória, o `prisma migrate deploy` usa ela
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?schema=public"
DIRECT_URL="postgresql://usuario:senha@host:5432/banco?schema=public"

# ─── Autenticação ───────────────────────────────────────────────────────────
# Gere cada uma com: openssl rand -hex 32
AUTH_SECRET=""
OPERADOR_SECRET=""

# ─── App ────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
SEED_DEMO=1

# ─── Integrações (vazias = modo demo, o fluxo roda igual) ───────────────────
# ANTHROPIC_API_KEY=
# ASAAS_API_KEY=
# UAZAPI_URL=
# ZAPSIGN_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=
